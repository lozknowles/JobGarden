---
const experienceItems = [
  {
    title: "Product & Implementation Adviser",
    period: "2020 - Present",
    body:
      "Helping HR software teams make better product, delivery, and implementation decisions with independent assurance and stakeholder alignment.",
  },
  {
    title: "Senior Product & Delivery Leadership",
    period: "2008 - 2020",
    body:
      "Led product, delivery, and customer-facing transformation work across HR software, SaaS, and payroll environments.",
  },
  {
    title: "Education & Professional Development",
    period: "Ongoing",
    body:
      "Technical, commercial, and leadership learning shaped by practical software delivery, advisory work, and continuous development.",
  },
];

const workItems = [
  {
    label: "Implementation assurance",
    title: "Independent oversight for complex HR software programmes",
    body:
      "Supporting delivery confidence through structured review, risk reduction, and better decision making.",
  },
  {
    label: "Product strategy",
    title: "Roadmaps that align customer needs with commercial goals",
    body:
      "Helping teams connect product direction, adoption, and practical delivery outcomes.",
  },
  {
    label: "Stakeholder alignment",
    title: "Clear communication across leadership, product, and delivery",
    body:
      "Translating complexity into decisions that customers, sponsors, and teams can act on.",
  },
  {
    label: "HR software insight",
    title: "Experience across payroll, SaaS, and enterprise HR systems",
    body:
      "Bringing long-term sector knowledge to strategy, implementation, and assurance conversations.",
  },
];
---

<section class="portfolio-shell">
  <div class="page-glow glow-left" aria-hidden="true"></div>
  <div class="page-glow glow-right" aria-hidden="true"></div>

  <header class="site-header">
    <nav class="topbar" aria-label="Primary">
      <a class="brand" href="#top">LK.</a>
      <div class="topbar-links">
        <a href="#top">Home</a>
        <a href="#about">About</a>
        <a href="#experience">Experience</a>
        <a href="#work">Selected Work</a>
        <a href="#contact">Contact</a>
      </div>
      <a class="button primary topbar-cta" href="#contact">Let's Talk</a>
    </nav>
  </header>

  <main class="page-frame" id="top">
    <section class="hero-panel">
      <div class="hero-copy">
        <p class="intro-line">Hi, I'm</p>
        <h1>Lawrence Knowles</h1>
        <p class="hero-subtitle">HR Software Product &amp; Implementation Assurance</p>
        <p class="lede">
          I help HR software teams make better product, delivery, and implementation decisions,
          combining product leadership with independent assurance to drive real impact.
        </p>

        <div class="hero-actions">
          <a class="button primary" href="#contact">Let's Talk</a>
          <a class="button ghost" href="#work">View Selected Work</a>
        </div>

        <div class="social-links" aria-label="Public links">
          <a href="https://github.com/lozknowles" target="_blank" rel="noreferrer">GitHub</a>
          <a href="https://uk.linkedin.com/in/lozknowles" target="_blank" rel="noreferrer">LinkedIn</a>
          <a href="https://www.youtube.com/@LawrenceKnowles-cr9ml" target="_blank" rel="noreferrer">YouTube</a>
        </div>
      </div>

      <aside class="hero-visual" aria-label="Portrait and profile highlights">
        <div class="portrait-halo" aria-hidden="true"></div>
        <img
          class="portrait-image"
          src="/profile.png"
          alt="Portrait of Lawrence Knowles"
        />

        <div class="floating-card card-availability">
          <span class="status-dot" aria-hidden="true"></span>
          <div>
            <strong>Available for advisory work</strong>
            <p>Independent / strategic support</p>
          </div>
        </div>

        <div class="floating-card card-trust">
          <strong>Trusted by leaders</strong>
          <p>Across HR software and enterprise delivery environments</p>
        </div>

        <div class="floating-card card-years">
          <strong>20+ years</strong>
          <p>Experience</p>
        </div>
      </aside>
    </section>

    <section class="section split-section" id="about">
      <div class="section-copy">
        <p class="section-kicker">About Me</p>
        <h2>Product leader. Trusted adviser. Implementation assurance.</h2>
        <p>
          I partner with HR software organisations to shape strategy, solve complex problems, and
          deliver outcomes that create lasting value for customers and their people.
        </p>
        <div class="chip-row">
          <span>Product Strategy</span>
          <span>Implementation Assurance</span>
          <span>Stakeholder Leadership</span>
          <span>SaaS</span>
          <span>Payroll</span>
          <span>HRIS</span>
        </div>
      </div>

      <div class="experience-list" id="experience">
        <p class="section-kicker">Experience</p>
        {experienceItems.map((item) => (
          <article class="experience-item">
            <div class="experience-marker" aria-hidden="true"></div>
            <div class="experience-content">
              <div class="experience-meta">
                <h3>{item.title}</h3>
                <span>{item.period}</span>
              </div>
              <p>{item.body}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="section work-section" id="work">
      <div class="section-header">
        <div>
          <p class="section-kicker">Selected Work</p>
          <h2>Public examples and current focus</h2>
        </div>
      </div>

      <div class="work-grid">
        {workItems.map((item, index) => (
          <article class="work-card">
            <div class={`work-preview preview-${index + 1}`}></div>
            <div class="work-body">
              <span class="work-label">{item.label}</span>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="section contact-section" id="contact">
      <div class="contact-copy">
        <p class="section-kicker">Contact</p>
        <h2>Let's build better outcomes together.</h2>
        <p>
          Open to advisory, product leadership, and implementation assurance conversations in HR
          software.
        </p>
        <div class="contact-list">
          <a href="mailto:lozknowles@mac.com">lozknowles@mac.com</a>
          <span>Newark, Nottinghamshire, UK</span>
          <a href="https://uk.linkedin.com/in/lozknowles" target="_blank" rel="noreferrer">LinkedIn</a>
        </div>
      </div>

      <div class="contact-panel" aria-label="Contact form preview">
        <div class="form-row">
          <div class="field">
            <label>Name</label>
            <span>Your name</span>
          </div>
          <div class="field">
            <label>Email</label>
            <span>your.email@example.com</span>
          </div>
        </div>
        <div class="field field-message">
          <label>Message</label>
          <span>Tell me about your project or role...</span>
        </div>
        <a class="button primary form-button" href="mailto:lozknowles@mac.com">Send Message</a>
      </div>
    </section>
  </main>
</section>

<style is:global>
  :global(body.bg-black) {
    margin: 0;
    color: #111827;
    background:
      radial-gradient(circle at top left, rgba(134, 161, 255, 0.18), transparent 24%),
      radial-gradient(circle at top right, rgba(210, 193, 255, 0.18), transparent 20%),
      radial-gradient(circle at 85% 82%, rgba(183, 207, 255, 0.18), transparent 18%),
      linear-gradient(180deg, #ffffff 0%, #fafbff 50%, #f7f7ff 100%);
    font-family: "Avenir Next", "Segoe UI", "Trebuchet MS", sans-serif;
    line-height: 1.55;
  }

  :global(body.bg-black a) {
    color: inherit;
    text-decoration: none;
  }

  :global(body.bg-black main) {
    display: block;
  }

  .portfolio-shell {
    position: relative;
    width: min(calc(100% - 28px), 1480px);
    margin: 14px auto 36px;
    padding-bottom: 28px;
  }

  .page-glow {
    position: absolute;
    border-radius: 999px;
    filter: blur(10px);
    pointer-events: none;
  }

  .glow-left {
    width: 240px;
    height: 240px;
    left: -60px;
    top: 110px;
    background: rgba(123, 145, 255, 0.12);
  }

  .glow-right {
    width: 280px;
    height: 280px;
    right: -40px;
    bottom: 60px;
    background: rgba(195, 170, 255, 0.14);
  }

  .site-header,
  .page-frame {
    border: 1px solid rgba(120, 132, 164, 0.12);
    background: rgba(255, 255, 255, 0.86);
    box-shadow: 0 20px 60px rgba(126, 143, 194, 0.08);
    backdrop-filter: blur(16px);
  }

  .site-header {
    border-radius: 26px 26px 0 0;
    border-bottom: 0;
  }

  .page-frame {
    border-radius: 0 0 26px 26px;
    overflow: hidden;
  }

  .topbar {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 28px;
    padding: 20px 42px;
  }

  .brand {
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.05em;
    color: #0f172a;
  }

  .topbar-links {
    display: flex;
    justify-content: center;
    gap: 34px;
    color: #475467;
    font-size: 0.98rem;
  }

  .topbar-links a:first-child {
    color: #111827;
    font-weight: 700;
  }

  .topbar-cta {
    justify-self: end;
  }

  .hero-panel {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(420px, 0.95fr);
    gap: 36px;
    align-items: center;
    padding: 44px 42px 28px;
    border-top: 1px solid rgba(120, 132, 164, 0.1);
  }

  .hero-copy {
    padding-right: 12px;
  }

  .intro-line {
    margin: 0 0 10px;
    color: #667085;
    font-size: 1.1rem;
    font-weight: 500;
  }

  h1,
  h2,
  h3 {
    margin: 0;
    letter-spacing: -0.04em;
    color: #0f172a;
  }

  h1 {
    font-size: clamp(3.4rem, 7vw, 5.6rem);
    line-height: 0.96;
    max-width: 8.5ch;
  }

  .hero-subtitle {
    margin: 18px 0 0;
    color: #4f6df5;
    font-size: clamp(1.45rem, 2.5vw, 2rem);
    font-weight: 500;
    letter-spacing: -0.03em;
  }

  .lede {
    max-width: 38rem;
    margin: 18px 0 0;
    color: #667085;
    font-size: 1.18rem;
    line-height: 1.65;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 28px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 0 22px;
    border-radius: 16px;
    font-weight: 700;
    transition: transform 0.18s ease, box-shadow 0.18s ease, background-color 0.18s ease;
  }

  .button:hover {
    transform: translateY(-1px);
  }

  .button.primary {
    color: #ffffff;
    background: linear-gradient(135deg, #0f172a, #1f2937);
    box-shadow: 0 16px 28px rgba(15, 23, 42, 0.16);
  }

  .button.ghost {
    color: #111827;
    border: 1px solid rgba(120, 132, 164, 0.16);
    background: rgba(255, 255, 255, 0.92);
  }

  .social-links {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: 22px;
    color: #101828;
    font-weight: 600;
  }

  .hero-visual {
    position: relative;
    min-height: 500px;
    display: flex;
    align-items: end;
    justify-content: center;
  }

  .portrait-halo {
    position: absolute;
    inset: 40px 30px 16px 70px;
    border-radius: 44% 56% 42% 58% / 48% 42% 58% 52%;
    background:
      radial-gradient(circle at top right, rgba(255, 255, 255, 0.72), transparent 24%),
      linear-gradient(135deg, rgba(194, 204, 255, 0.78), rgba(222, 214, 255, 0.78));
  }

  .portrait-image {
    position: relative;
    z-index: 1;
    width: min(100%, 640px);
    max-height: 560px;
    object-fit: contain;
    object-position: center bottom;
    filter: brightness(1.02) contrast(1.02);
  }

  .floating-card {
    position: absolute;
    z-index: 2;
    display: grid;
    gap: 4px;
    min-width: 180px;
    padding: 18px 20px;
    border-radius: 20px;
    border: 1px solid rgba(120, 132, 164, 0.12);
    background: rgba(255, 255, 255, 0.9);
    box-shadow: 0 20px 40px rgba(126, 143, 194, 0.12);
    backdrop-filter: blur(16px);
  }

  .floating-card strong {
    font-size: 1rem;
    color: #0f172a;
  }

  .floating-card p {
    margin: 0;
    color: #667085;
    font-size: 0.92rem;
  }

  .card-availability {
    top: 54px;
    right: 8px;
    grid-template-columns: auto 1fr;
    align-items: start;
    column-gap: 12px;
  }

  .status-dot {
    width: 10px;
    height: 10px;
    margin-top: 6px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 0 5px rgba(34, 197, 94, 0.12);
  }

  .card-trust {
    left: 14px;
    bottom: 94px;
    max-width: 240px;
  }

  .card-years {
    right: -6px;
    bottom: 146px;
    max-width: 150px;
  }

  .section {
    padding: 30px 42px;
    border-top: 1px solid rgba(120, 132, 164, 0.1);
  }

  .split-section {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: 34px;
    align-items: start;
  }

  .section-kicker {
    margin: 0 0 12px;
    color: #5c6cff;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 0.8rem;
    font-weight: 700;
  }

  .section-copy h2,
  .section-header h2,
  .contact-copy h2 {
    font-size: clamp(2rem, 3.2vw, 3.2rem);
    line-height: 1.05;
    max-width: 12ch;
  }

  .section-copy p,
  .contact-copy p {
    max-width: 42rem;
    margin: 18px 0 0;
    color: #667085;
    font-size: 1.04rem;
  }

  .chip-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 22px;
  }

  .chip-row span {
    padding: 8px 12px;
    border-radius: 999px;
    border: 1px solid rgba(120, 132, 164, 0.12);
    background: rgba(255, 255, 255, 0.9);
    color: #344054;
    font-size: 0.88rem;
    font-weight: 600;
  }

  .experience-list {
    padding-left: 28px;
    border-left: 1px solid rgba(120, 132, 164, 0.1);
  }

  .experience-item {
    display: grid;
    grid-template-columns: 26px 1fr;
    gap: 18px;
    align-items: start;
    margin-top: 18px;
  }

  .experience-marker {
    width: 14px;
    height: 14px;
    margin-top: 8px;
    border-radius: 50%;
    background: linear-gradient(135deg, #6b7cff, #8fa0ff);
    box-shadow: 0 0 0 7px rgba(107, 124, 255, 0.12);
  }

  .experience-meta {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    align-items: baseline;
  }

  .experience-meta h3 {
    font-size: 1.18rem;
  }

  .experience-meta span,
  .experience-content p {
    color: #667085;
  }

  .experience-content p {
    margin: 8px 0 0;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 18px;
    margin-bottom: 22px;
  }

  .work-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
  }

  .work-card {
    overflow: hidden;
    border-radius: 20px;
    border: 1px solid rgba(120, 132, 164, 0.12);
    background: rgba(255, 255, 255, 0.94);
    box-shadow: 0 14px 30px rgba(126, 143, 194, 0.08);
  }

  .work-preview {
    height: 150px;
    border-bottom: 1px solid rgba(120, 132, 164, 0.08);
    background-size: cover;
    background-position: center;
  }

  .preview-1 {
    background:
      radial-gradient(circle at 70% 30%, rgba(77, 107, 255, 0.34), transparent 22%),
      linear-gradient(135deg, #101828, #1d2939 70%, #334155);
  }

  .preview-2 {
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.62), rgba(255, 255, 255, 0.1)),
      linear-gradient(135deg, #f4f7ff, #eef2ff 58%, #dbe8ff);
  }

  .preview-3 {
    background:
      radial-gradient(circle at 30% 25%, rgba(89, 109, 255, 0.3), transparent 20%),
      linear-gradient(135deg, #eef2ff, #f5f3ff 62%, #ecfeff);
  }

  .preview-4 {
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.5), rgba(255, 255, 255, 0.08)),
      linear-gradient(135deg, #ffffff, #f4f7ff 58%, #e6efff);
  }

  .work-body {
    padding: 18px;
  }

  .work-label {
    display: inline-block;
    margin-bottom: 10px;
    color: #5c6cff;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .work-body h3 {
    font-size: 1.16rem;
    line-height: 1.2;
  }

  .work-body p {
    margin: 10px 0 0;
    color: #667085;
    font-size: 0.96rem;
  }

  .contact-section {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: 32px;
    align-items: start;
  }

  .contact-list {
    display: grid;
    gap: 12px;
    margin-top: 24px;
    color: #475467;
    font-weight: 600;
  }

  .contact-panel {
    padding: 20px;
    border-radius: 22px;
    border: 1px solid rgba(120, 132, 164, 0.12);
    background: rgba(255, 255, 255, 0.92);
    box-shadow: 0 16px 36px rgba(126, 143, 194, 0.08);
  }

  .form-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .field {
    display: grid;
    gap: 8px;
    margin-bottom: 16px;
  }

  .field label {
    color: #344054;
    font-size: 0.88rem;
    font-weight: 700;
  }

  .field span {
    display: flex;
    align-items: center;
    min-height: 50px;
    padding: 0 16px;
    border-radius: 14px;
    border: 1px solid rgba(120, 132, 164, 0.12);
    color: #98a2b3;
    background: rgba(255, 255, 255, 0.96);
  }

  .field-message span {
    min-height: 120px;
    align-items: start;
    padding-top: 14px;
  }

  .form-button {
    width: 100%;
  }

  @media (max-width: 1180px) {
    .hero-panel,
    .split-section,
    .contact-section {
      grid-template-columns: 1fr;
    }

    .work-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .experience-list {
      padding-left: 0;
      border-left: 0;
    }
  }

  @media (max-width: 800px) {
    .portfolio-shell {
      width: min(calc(100% - 16px), 1480px);
      margin-top: 8px;
    }

    .topbar,
    .hero-panel,
    .section {
      padding-left: 20px;
      padding-right: 20px;
    }

    .topbar {
      grid-template-columns: 1fr;
      justify-items: start;
    }

    .topbar-links {
      justify-content: flex-start;
      flex-wrap: wrap;
      gap: 16px;
    }

    .hero-visual {
      min-height: 380px;
    }

    .portrait-halo {
      inset: 24px 10px 12px 24px;
    }

    .work-grid,
    .form-row {
      grid-template-columns: 1fr;
    }

    .card-availability,
    .card-trust,
    .card-years {
      position: static;
      margin-top: 12px;
    }

    .hero-visual {
      display: grid;
      justify-items: center;
      gap: 12px;
    }
  }
</style>
