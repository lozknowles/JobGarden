---
---

<section class="portfolio-shell">
  <div class="portfolio-glow portfolio-glow-left" aria-hidden="true"></div>
  <div class="portfolio-glow portfolio-glow-right" aria-hidden="true"></div>

  <header class="hero">
    <nav class="topbar" aria-label="Primary">
      <a class="brand" href="#top">lozknowles.com</a>
      <div class="topbar-links">
        <a href="#focus">Focus</a>
        <a href="#experience">Experience</a>
        <a href="#projects">Projects</a>
        <a href="#contact">Contact</a>
      </div>
    </nav>

    <div class="hero-grid" id="top">
      <section class="hero-copy">
        <p class="eyebrow">Public portfolio</p>
        <h1>Lawrence Charles Knowles</h1>
        <p class="lede">
          Product leadership and implementation assurance for HR software, with a track record across
          SaaS, payroll, enterprise delivery, and customer-facing transformation work.
        </p>

        <div class="hero-actions">
          <a class="button primary" href="#contact">Get in touch</a>
          <a class="button ghost" href="https://github.com/lozknowles" target="_blank" rel="noreferrer">GitHub</a>
        </div>

        <ul class="hero-tags" aria-label="Highlights">
          <li>UK citizen</li>
          <li>Newark, Nottinghamshire</li>
          <li>HR software</li>
          <li>Product management</li>
          <li>Implementation assurance</li>
        </ul>
      </section>

      <aside class="profile-panel" aria-label="Profile and quick facts">
        <div class="portrait-frame">
          <img
            class="portrait-image"
            src="/profile.png"
            alt="Portrait of Lawrence Charles Knowles"
          />
          <div class="portrait-badge">
            <span class="panel-label">Independent adviser</span>
            <strong>Product strategy, assurance, and trusted delivery oversight</strong>
          </div>
        </div>
        <div class="panel-card accent">
          <span class="panel-label">Current focus</span>
          <strong>Helping HR software teams make better product and implementation decisions.</strong>
        </div>
        <div class="panel-card">
          <span class="panel-label">Working style</span>
          <p>Commercial, strategic, relationship-led, and comfortable speaking to senior stakeholders.</p>
        </div>
        <div class="panel-card">
          <span class="panel-label">Public links</span>
          <p>
            <a href="https://uk.linkedin.com/in/lozknowles" target="_blank" rel="noreferrer">LinkedIn</a>
            <span aria-hidden="true">|</span>
            <a href="https://www.youtube.com/@LawrenceKnowles-cr9ml" target="_blank" rel="noreferrer">YouTube</a>
            <span aria-hidden="true">|</span>
            <a href="https://collingham.org" target="_blank" rel="noreferrer">Collingham.org</a>
          </p>
        </div>
      </aside>
    </div>
  </header>

  <main>
    <section class="section" id="focus">
      <div class="section-heading">
        <p class="eyebrow">Focus</p>
        <h2>What I bring</h2>
      </div>

      <div class="card-grid three-up">
        <article class="card">
          <h3>Product judgement</h3>
          <p>Shaping product direction around commercial reality, customer outcomes, and the practical needs of HR and payroll teams.</p>
        </article>
        <article class="card">
          <h3>Implementation assurance</h3>
          <p>Reviewing current-state gaps, guiding selection choices, and helping teams reduce risk during complex software implementations.</p>
        </article>
        <article class="card">
          <h3>Board-level communication</h3>
          <p>Translating technical and delivery detail into language that helps executives make faster, better decisions.</p>
        </article>
      </div>
    </section>

    <section class="section" id="experience">
      <div class="section-heading">
        <p class="eyebrow">Experience</p>
        <h2>Selected background</h2>
      </div>

      <div class="timeline">
        <article class="timeline-item">
          <div class="timeline-marker"></div>
          <div class="timeline-content">
            <h3>HR software and payroll leadership</h3>
            <p>Senior leadership across software, payroll, and SaaS businesses, including product direction, customer strategy, and market-facing growth.</p>
          </div>
        </article>
        <article class="timeline-item">
          <div class="timeline-marker"></div>
          <div class="timeline-content">
            <h3>Implementation and current-state review</h3>
            <p>Advisory work on HR and payroll implementations, system selection, and process improvement, including audit-style review of live environments.</p>
          </div>
        </article>
        <article class="timeline-item">
          <div class="timeline-marker"></div>
          <div class="timeline-content">
            <h3>Community and digital projects</h3>
            <p>Public-facing digital work including Collingham.org, local history digitisation, and other practical projects that make information easier to find and use.</p>
          </div>
        </article>
      </div>
    </section>

    <section class="section" id="projects">
      <div class="section-heading">
        <p class="eyebrow">Public work</p>
        <h2>Selected public examples</h2>
      </div>

      <div class="card-grid two-up">
        <article class="card project-card">
          <div class="card-topline">
            <span class="pill">Public project</span>
            <a href="https://collingham.org" target="_blank" rel="noreferrer">Visit site</a>
          </div>
          <h3>Collingham.org</h3>
          <p>Community and local-history focused digital work that demonstrates practical organisation, content care, and public communication.</p>
        </article>

        <article class="card project-card">
          <div class="card-topline">
            <span class="pill">Public channel</span>
            <a href="https://www.youtube.com/@LawrenceKnowles-cr9ml" target="_blank" rel="noreferrer">Open channel</a>
          </div>
          <h3>YouTube presence</h3>
          <p>A public channel used for selected examples and supporting material. More portfolio items can be added here as they become public-safe.</p>
        </article>

        <article class="card project-card">
          <div class="card-topline">
            <span class="pill">Code profile</span>
            <a href="https://github.com/lozknowles" target="_blank" rel="noreferrer">View GitHub</a>
          </div>
          <h3>GitHub profile</h3>
          <p>Public code and tooling will live here as the portfolio grows. The focus is on useful, public-safe examples rather than private application material.</p>
        </article>

        <article class="card project-card">
          <div class="card-topline">
            <span class="pill">JobGarden</span>
            <span class="muted">Internal support tool</span>
          </div>
          <h3>Application workflow tooling</h3>
          <p>JobGarden powers the private application process, CV generation, and review workflow. Only public-safe material belongs on this portfolio site.</p>
        </article>
      </div>
    </section>

    <section class="section" id="contact">
      <div class="section-heading">
        <p class="eyebrow">Contact</p>
        <h2>Let's talk</h2>
      </div>

      <div class="contact-band">
        <p>If you are hiring for HR software product, implementation assurance, or related leadership work, the quickest route is LinkedIn or email.</p>
        <div class="contact-links">
          <a class="button primary" href="mailto:lozknowles@mac.com">Email Lawrence</a>
          <a class="button ghost" href="https://uk.linkedin.com/in/lozknowles" target="_blank" rel="noreferrer">LinkedIn profile</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <p>This portfolio is intentionally public-only. Private job applications, tracker data, generated CVs, and draft statements are kept out of the live site.</p>
  </footer>
</section>

<style is:global>
  :global(body.bg-black) {
    margin: 0;
    color: #16212c;
    background:
      radial-gradient(circle at top left, rgba(33, 94, 99, 0.16), transparent 30%),
      radial-gradient(circle at top right, rgba(164, 93, 42, 0.18), transparent 28%),
      linear-gradient(180deg, #f9f4ea 0%, #f5efe3 40%, #efe4d1 100%);
    font-family: "Avenir Next", "Gill Sans", "Trebuchet MS", sans-serif;
    line-height: 1.55;
  }

  :global(body.bg-black a) {
    color: inherit;
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.16em;
  }

  :global(body.bg-black a:hover) {
    color: #215e63;
  }

  :global(body.bg-black main) {
    display: block;
  }

  .portfolio-shell {
    width: min(calc(100% - 32px), 1120px);
    margin: 0 auto;
    padding: 20px 0 40px;
    position: relative;
    overflow: hidden;
  }

  .portfolio-glow {
    position: absolute;
    border-radius: 999px;
    filter: blur(4px);
    pointer-events: none;
  }

  .portfolio-glow-left {
    width: 260px;
    height: 260px;
    left: -80px;
    top: 120px;
    background: rgba(33, 94, 99, 0.08);
  }

  .portfolio-glow-right {
    width: 180px;
    height: 180px;
    right: -40px;
    top: 60px;
    background: rgba(164, 93, 42, 0.08);
  }

  .hero,
  .section,
  .footer {
    position: relative;
    overflow: hidden;
  }

  .hero {
    padding: 8px 0 34px;
  }

  .topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 10px 0 24px;
  }

  .brand {
    font-family: "Iowan Old Style", "Palatino Linotype", "Book Antiqua", Georgia, serif;
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-decoration: none;
  }

  .topbar-links {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    color: #586575;
    font-size: 0.95rem;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(280px, 0.9fr);
    gap: 28px;
    align-items: stretch;
  }

  .hero-copy,
  .profile-panel,
  .card,
  .contact-band {
    border: 1px solid rgba(22, 33, 44, 0.12);
    background: rgba(255, 255, 255, 0.72);
    backdrop-filter: blur(18px);
    box-shadow: 0 24px 60px rgba(22, 33, 44, 0.12);
  }

  .hero-copy {
    padding: clamp(28px, 5vw, 54px);
    border-radius: 28px;
  }

  .eyebrow {
    margin: 0 0 12px;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 0.76rem;
    font-weight: 700;
    color: #a45d2a;
  }

  .hero h1,
  .section h2,
  .card h3,
  .brand {
    margin: 0;
    font-family: "Iowan Old Style", "Palatino Linotype", "Book Antiqua", Georgia, serif;
  }

  .hero h1 {
    font-size: clamp(3rem, 7vw, 5.4rem);
    line-height: 0.95;
    letter-spacing: -0.04em;
    max-width: 11ch;
  }

  .lede {
    max-width: 58ch;
    margin: 22px 0 0;
    font-size: clamp(1.08rem, 2vw, 1.26rem);
    color: #586575;
  }

  .hero-actions,
  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 0 18px;
    border-radius: 999px;
    font-weight: 700;
    text-decoration: none;
    transition: transform 0.18s ease, box-shadow 0.18s ease, background-color 0.18s ease;
  }

  .button:hover {
    transform: translateY(-1px);
  }

  .button.primary {
    color: #f9f4ea;
    background: linear-gradient(135deg, #215e63, #123f43);
    box-shadow: 0 18px 30px rgba(33, 94, 99, 0.22);
  }

  .button.ghost {
    border: 1px solid rgba(22, 33, 44, 0.12);
    background: rgba(255, 255, 255, 0.55);
  }

  .hero-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    list-style: none;
    padding: 0;
    margin: 28px 0 0;
  }

  .hero-tags li,
  .pill {
    border: 1px solid rgba(33, 94, 99, 0.14);
    background: rgba(255, 255, 255, 0.72);
    color: #215e63;
    border-radius: 999px;
    padding: 8px 12px;
    font-size: 0.92rem;
    font-weight: 700;
  }

  .profile-panel {
    display: grid;
    gap: 14px;
    padding: 18px;
    border-radius: 24px;
  }

  .portrait-frame {
    position: relative;
    overflow: hidden;
    min-height: 520px;
    border-radius: 22px;
    border: 1px solid rgba(22, 33, 44, 0.08);
    background:
      linear-gradient(180deg, rgba(15, 25, 34, 0.05), rgba(15, 25, 34, 0.22)),
      linear-gradient(145deg, rgba(255, 255, 255, 0.42), rgba(255, 255, 255, 0.12));
  }

  .portrait-frame::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(11, 19, 26, 0.02), rgba(11, 19, 26, 0.34) 85%),
      radial-gradient(circle at top right, rgba(255, 255, 255, 0.22), transparent 30%);
    pointer-events: none;
  }

  .portrait-image {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 520px;
    object-fit: cover;
    object-position: 58% center;
    filter: saturate(0.95) contrast(1.03);
  }

  .portrait-badge {
    position: absolute;
    left: 18px;
    right: 18px;
    bottom: 18px;
    z-index: 1;
    padding: 16px 18px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 18px;
    color: #f8f2e7;
    background: linear-gradient(180deg, rgba(10, 18, 25, 0.2), rgba(10, 18, 25, 0.72));
    backdrop-filter: blur(10px);
    box-shadow: 0 18px 30px rgba(10, 18, 25, 0.24);
  }

  .portrait-badge .panel-label {
    color: rgba(248, 242, 231, 0.76);
    margin-bottom: 6px;
  }

  .panel-card {
    border-radius: 18px;
    padding: 18px;
    background: rgba(255, 255, 255, 0.58);
    border: 1px solid rgba(22, 33, 44, 0.08);
  }

  .panel-card.accent {
    background: linear-gradient(160deg, rgba(33, 94, 99, 0.12), rgba(255, 255, 255, 0.84));
  }

  .panel-label {
    display: block;
    margin-bottom: 8px;
    font-size: 0.74rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #586575;
  }

  .section {
    margin-top: 16px;
    padding: 14px 0;
  }

  .section-heading {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-bottom: 18px;
  }

  .section h2 {
    font-size: clamp(2rem, 4vw, 2.8rem);
    letter-spacing: -0.03em;
  }

  .card-grid {
    display: grid;
    gap: 18px;
  }

  .card-grid.three-up {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .card-grid.two-up {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .card {
    border-radius: 24px;
    padding: 24px;
  }

  .card h3 {
    font-size: 1.35rem;
    margin-bottom: 10px;
  }

  .card p {
    margin: 0;
    color: #586575;
  }

  .timeline {
    display: grid;
    gap: 16px;
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 14px minmax(0, 1fr);
    gap: 18px;
    align-items: start;
    padding: 20px 22px;
    border-radius: 24px;
    border: 1px solid rgba(22, 33, 44, 0.12);
    background: rgba(255, 255, 255, 0.62);
  }

  .timeline-marker {
    width: 14px;
    height: 14px;
    margin-top: 9px;
    border-radius: 50%;
    background: linear-gradient(135deg, #215e63, #a45d2a);
    box-shadow: 0 0 0 8px rgba(33, 94, 99, 0.08);
  }

  .timeline-content h3 {
    margin-bottom: 8px;
  }

  .project-card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-height: 100%;
  }

  .card-topline {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }

  .muted {
    color: #586575;
    font-size: 0.95rem;
  }

  .contact-band {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 18px;
    align-items: center;
    padding: 26px;
    border-radius: 26px;
  }

  .contact-band p {
    margin: 0;
    max-width: 60ch;
    color: #586575;
  }

  .footer {
    padding: 20px 0 0;
    color: #586575;
    font-size: 0.95rem;
  }

  .footer p {
    margin: 0;
    max-width: 70ch;
  }

  @media (max-width: 900px) {
    .hero-grid,
    .card-grid.three-up,
    .card-grid.two-up,
    .contact-band {
      grid-template-columns: 1fr;
    }

    .topbar {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (max-width: 640px) {
    .portfolio-shell {
      width: min(calc(100% - 20px), 1120px);
      padding-top: 10px;
    }

    .hero-copy,
    .card,
    .timeline-item,
    .contact-band {
      padding: 20px;
    }

    .hero h1 {
      max-width: 9ch;
    }

    .portrait-frame,
    .portrait-image {
      min-height: 420px;
    }

    .topbar-links {
      gap: 12px;
    }
  }
</style>
