<script is:inline>
  const initOrbitCarousel = () => {
    const viewport = document.querySelector('[data-orbit-viewport]');
    const ring = document.querySelector('[data-orbit-ring]');
    const cards = Array.from(document.querySelectorAll('[data-orbit-card]'));
    const focus = document.querySelector('[data-orbit-focus]');
    const focusImage = document.querySelector('[data-orbit-focus-image]');
    const focusLabel = document.querySelector('[data-orbit-focus-label]');
    const focusTitle = document.querySelector('[data-orbit-focus-title]');
    const focusBody = document.querySelector('[data-orbit-focus-body]');
    const focusLink = document.querySelector('[data-orbit-focus-link]');
    const focusMeta = document.querySelector('[data-orbit-focus-meta]');
    const position = document.querySelector('[data-orbit-position]');
    const prevButton = document.querySelector('[data-orbit-prev]');
    const nextButton = document.querySelector('[data-orbit-next]');
    const toggleButton = document.querySelector('[data-orbit-toggle]');

    if (!viewport || !ring || !cards.length || !focus || !focusImage || !focusLabel || !focusTitle || !focusBody || !focusLink || !focusMeta || !position || !prevButton || !nextButton || !toggleButton) {
      return;
    }

    const items = cards.map((card) => ({
      image: card.querySelector('img')?.getAttribute('src') ?? '',
      alt: card.querySelector('img')?.getAttribute('alt') ?? '',
      label: card.querySelector('.work-label')?.textContent ?? '',
      title: card.querySelector('h3')?.textContent ?? '',
      body: card.querySelector('p')?.textContent ?? '',
      link: card.querySelector('a')?.getAttribute('href') ?? '#',
      linkLabel: card.querySelector('a')?.textContent ?? 'Open project',
      meta: card.querySelector('.muted')?.textContent ?? '',
    }));

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const angleStep = 360 / cards.length;
    let rotation = 0;
    let activeIndex = 0;
    let playing = !prefersReducedMotion.matches;
    let rafId = null;
    let lastTimestamp = 0;
    let dragState = null;
    let resumeTimer = null;

    const normalize = (value) => {
      const wrapped = value % 360;
      return wrapped < 0 ? wrapped + 360 : wrapped;
    };

    const updateFocus = (index) => {
      const item = items[index];
      if (!item) return;

      focusImage.src = item.image;
      focusImage.alt = item.alt;
      focusLabel.textContent = item.label;
      focusTitle.textContent = item.title;
      focusBody.textContent = item.body;
      focusLink.href = item.link;
      focusLink.textContent = item.linkLabel;
      focusMeta.textContent = item.meta;
      position.textContent = `${String(index + 1).padStart(2, '0')} / ${String(items.length).padStart(2, '0')}`;

      cards.forEach((card, cardIndex) => {
        const isActive = cardIndex === index;
        card.dataset.active = String(isActive);
        card.setAttribute('aria-hidden', isActive ? 'false' : 'true');
      });
    };

    const sync = () => {
      ring.style.setProperty('--orbit-rotation', `${rotation}deg`);
      const nextIndex = Math.round(normalize(rotation) / angleStep) % cards.length;
      if (nextIndex !== activeIndex) {
        activeIndex = nextIndex;
        updateFocus(activeIndex);
      }
    };

    const nudge = (direction) => {
      rotation += direction * angleStep;
      sync();
    };

    const stopAutoplay = () => {
      playing = false;
      toggleButton.textContent = 'Play';
      toggleButton.setAttribute('aria-pressed', 'false');
      lastTimestamp = 0;
      if (rafId) {
        window.cancelAnimationFrame(rafId);
        rafId = null;
      }
    };

    const startAutoplay = () => {
      if (prefersReducedMotion.matches) {
        stopAutoplay();
        return;
      }

      playing = true;
      toggleButton.textContent = 'Pause';
      toggleButton.setAttribute('aria-pressed', 'true');
      lastTimestamp = 0;
      if (rafId) return;

      const tick = (timestamp) => {
        if (!playing) {
          rafId = null;
          return;
        }

        if (!lastTimestamp) lastTimestamp = timestamp;
        const delta = timestamp - lastTimestamp;
        lastTimestamp = timestamp;
        rotation += delta * 0.013;
        sync();
        rafId = window.requestAnimationFrame(tick);
      };

      rafId = window.requestAnimationFrame(tick);
    };

    const pauseTemporarily = () => {
      window.clearTimeout(resumeTimer);
      stopAutoplay();
      resumeTimer = window.setTimeout(() => {
        if (!prefersReducedMotion.matches) {
          startAutoplay();
        }
      }, 5200);
    };

    const setPointerCapture = (event) => {
      dragState = {
        id: event.pointerId,
        x: event.clientX,
        rotation,
      };
      viewport.setPointerCapture(event.pointerId);
      pauseTemporarily();
    };

    viewport.addEventListener('pointerdown', (event) => {
      if (event.button !== 0) return;
      setPointerCapture(event);
    });

    viewport.addEventListener('pointermove', (event) => {
      if (!dragState || dragState.id !== event.pointerId) return;
      const delta = event.clientX - dragState.x;
      rotation = dragState.rotation + delta * 0.35;
      sync();
    });

    const releasePointer = (event) => {
      if (dragState && dragState.id === event.pointerId) {
        dragState = null;
      }
    };

    viewport.addEventListener('pointerup', releasePointer);
    viewport.addEventListener('pointercancel', releasePointer);
    viewport.addEventListener('pointerleave', () => {
      if (!dragState) {
        window.clearTimeout(resumeTimer);
        if (!prefersReducedMotion.matches && !playing) {
          resumeTimer = window.setTimeout(() => startAutoplay(), 1200);
        }
      }
    });

    viewport.addEventListener('focusin', pauseTemporarily);
    viewport.addEventListener('focusout', () => {
      window.clearTimeout(resumeTimer);
      if (!prefersReducedMotion.matches) {
        resumeTimer = window.setTimeout(() => startAutoplay(), 900);
      }
    });

    viewport.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        pauseTemporarily();
        nudge(1);
      }
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        pauseTemporarily();
        nudge(-1);
      }
      if (event.key === ' ' || event.key === 'Spacebar') {
        event.preventDefault();
        if (playing) {
          stopAutoplay();
        } else {
          startAutoplay();
        }
      }
    });

    prevButton.addEventListener('click', () => {
      pauseTemporarily();
      nudge(-1);
    });

    nextButton.addEventListener('click', () => {
      pauseTemporarily();
      nudge(1);
    });

    toggleButton.addEventListener('click', () => {
      if (playing) {
        stopAutoplay();
      } else {
        window.clearTimeout(resumeTimer);
        startAutoplay();
      }
    });

    prefersReducedMotion.addEventListener?.('change', (event) => {
      if (event.matches) {
        stopAutoplay();
      } else {
        startAutoplay();
      }
    });

    cards.forEach((card, index) => {
      const angle = index * angleStep;
      card.style.setProperty('--angle', `${angle}deg`);
      card.addEventListener('click', () => {
        const targetRotation = index * angleStep;
        const current = normalize(rotation);
        const delta = normalize(targetRotation - current);
        const reverse = normalize(current - targetRotation);
        rotation += delta <= reverse ? delta : -reverse;
        pauseTemporarily();
        sync();
      });
    });

    updateFocus(0);
    sync();
    if (playing) {
      startAutoplay();
    }
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initOrbitCarousel, { once: true });
  } else {
    initOrbitCarousel();
  }
</script>

<style is:global>
  :global(body.bg-black) {
    margin: 0;
    color: #111827;
    background:
      radial-gradient(circle at top left, rgba(134, 161, 255, 0.1), transparent 24%),
      radial-gradient(circle at top right, rgba(210, 193, 255, 0.1), transparent 20%),
      radial-gradient(circle at 85% 82%, rgba(183, 207, 255, 0.1), transparent 18%),
      #ffffff;
    font-family: "Avenir Next", "Segoe UI", "Trebuchet MS", sans-serif;
    line-height: 1.55;
  }

  :global(body.bg-black a) {
    color: inherit;
    text-decoration: none;
  }

  :global(body.bg-black main) {
    display: block;
  }

  .portfolio-shell {
    position: relative;
    width: min(calc(100% - 28px), 1480px);
    margin: 14px auto 36px;
    padding-bottom: 28px;
  }

  .page-glow {
    position: absolute;
    border-radius: 999px;
    filter: blur(10px);
    pointer-events: none;
  }

  .glow-left {
    width: 240px;
    height: 240px;
    left: -60px;
    top: 110px;
    background: rgba(123, 145, 255, 0.12);
  }

  .glow-right {
    width: 280px;
    height: 280px;
    right: -40px;
    bottom: 60px;
    background: rgba(195, 170, 255, 0.14);
  }

  .site-header,
  .page-frame {
    border: 1px solid rgba(120, 132, 164, 0.12);
    background: rgba(255, 255, 255, 0.98);
    box-shadow: 0 20px 60px rgba(126, 143, 194, 0.08);
    backdrop-filter: blur(16px);
