---
const experienceItems = [
  {
    title: "Product & Implementation Adviser",
    period: "2020 - Present",
    body:
      "Helping HR software teams make better product, delivery, and implementation decisions with independent assurance and stakeholder alignment.",
  },
  {
    title: "Senior Product & Delivery Leadership",
    period: "2008 - 2020",
    body:
      "Led product, delivery, and customer-facing transformation work across HR software, SaaS, and payroll environments.",
  },
  {
    title: "Education & Professional Development",
    period: "Ongoing",
    body:
      "Technical, commercial, and leadership learning shaped by practical software delivery, advisory work, and continuous development.",
  },
];

const workItems = [
  {
    label: "Featured project",
    title: "Flower Detection Using Vision Processing",
    body:
      "A visual demo that uses computer vision to identify flowers and present the result clearly.",
    image: "/project-flower-detection.png",
    alt: "Computer vision interface detecting flowers with highlighted bounding boxes and analytics panels",
    link: "https://www.youtube.com/@LawrenceKnowles-cr9ml",
    linkLabel: "Watch the video",
    preview: "linear-gradient(135deg, rgba(33, 94, 99, 0.28), rgba(15, 23, 42, 0.86))",
  },
  {
    label: "Video project",
    title: "Hand Mapping Using AI Vision",
    body:
      "An AI vision experiment focused on hand mapping and interactive visual feedback.",
    image: "/project-hand-mapping.png",
    alt: "AI vision interface showing hand landmark tracking and a control dashboard",
    link: "https://www.youtube.com/@LawrenceKnowles-cr9ml",
    linkLabel: "Open on YouTube",
    preview: "linear-gradient(135deg, rgba(164, 93, 42, 0.34), rgba(15, 23, 42, 0.82))",
  },
  {
    label: "Design project",
    title: "Archive Automation Using AI OCR",
    body:
      "A workflow demo showing how OCR can speed up archive handling and reduce manual effort.",
    image: "/project-archive-ocr.png",
    alt: "Document processing interface with OCR extraction boxes and archive automation controls",
    link: "https://www.youtube.com/@LawrenceKnowles-cr9ml",
    linkLabel: "View project",
    preview: "linear-gradient(135deg, rgba(92, 108, 255, 0.32), rgba(34, 44, 72, 0.88))",
  },
  {
    label: "Public project",
    title: "Timelapse Dashboard Using AI",
    body:
      "A dashboard-led project that turns time-based activity into something easier to read at a glance.",
    image: "/project-timelapse-dashboard.png",
    alt: "Analytics dashboard with timelines, event markers, and AI summary panels",
    link: "https://www.youtube.com/@LawrenceKnowles-cr9ml",
    linkLabel: "Open on YouTube",
    preview: "linear-gradient(135deg, rgba(14, 94, 121, 0.34), rgba(11, 18, 32, 0.9))",
  },
  {
    label: "Case study",
    title: "Collingham.org",
    body:
      "Community-focused digital work with an emphasis on organisation, clarity, and public usefulness.",
    image: "/project-collingham.png",
    alt: "Community website homepage with archive tiles and editorial navigation",
    link: "https://collingham.org",
    linkLabel: "Visit site",
    preview: "linear-gradient(135deg, rgba(122, 92, 255, 0.3), rgba(20, 28, 48, 0.88))",
  },
  {
    label: "Current work",
    title: "Space Bike Simulator - 6502 Game",
    body:
      "A retro-inspired game project that shows programming range as well as playful problem solving.",
    image: "/project-space-bike.png",
    alt: "Retro game interface with a space bike simulator and pixel-art starfield",
    link: "https://github.com/lozknowles",
    linkLabel: "View GitHub",
    preview: "linear-gradient(135deg, rgba(45, 132, 110, 0.26), rgba(15, 23, 42, 0.84))",
  },
];

const nowSignals = [
  {
    label: "Now",
    value: "Turning public work into a more editorial, image-led portfolio.",
  },
  {
    label: "Format",
    value: "Using carousel-style cards, subtle motion, and stronger visual hierarchy.",
  },
  {
    label: "Focus",
    value: "Keeping the site calm, current, and easy to scan on mobile.",
  },
];
---

<section class="portfolio-shell">
  <div class="page-glow glow-left" aria-hidden="true"></div>
  <div class="page-glow glow-right" aria-hidden="true"></div>

  <header class="site-header">
    <nav class="topbar" aria-label="Primary">
      <a class="brand" href="#top">LK.</a>
      <div class="topbar-links">
        <a href="#top">Home</a>
        <a href="#about">About</a>
        <a href="#experience">Experience</a>
        <a href="#work">Examples</a>
        <a href="#contact">Contact</a>
      </div>
      <a class="button primary topbar-cta" href="#contact">Let's Talk</a>
    </nav>
  </header>

  <main class="page-frame" id="top">
    <section class="hero-panel">
      <div class="hero-copy">
        <p class="intro-line">Hi, I'm</p>
        <h1>Lawrence Knowles</h1>
        <p class="hero-subtitle">HR Software Product &amp; Implementation Assurance</p>
        <p class="lede">
          I help HR software teams make better product, delivery, and implementation decisions,
          combining product leadership with independent assurance to drive real impact.
        </p>

        <div class="hero-actions">
          <a class="button primary" href="#contact">Let's Talk</a>
        </div>

        <div class="signal-strip" aria-label="Current site signals">
          {nowSignals.map((item) => (
            <article class="signal-card">
              <span>{item.label}</span>
              <p>{item.value}</p>
            </article>
          ))}
        </div>
      </div>

      <aside class="hero-visual" aria-label="Portrait and profile highlights">
        <div class="portrait-halo" aria-hidden="true"></div>
        <img
          class="portrait-image"
          src="/profile.png"
          alt="Portrait of Lawrence Knowles"
        />

        <div class="floating-card card-availability">
          <span class="status-dot" aria-hidden="true"></span>
          <div>
            <strong>Available for advisory work</strong>
            <p>Independent / strategic support</p>
          </div>
        </div>

        <div class="floating-card card-trust">
          <strong>Selected work</strong>
          <p>Six public projects, one cohesive visual story</p>
        </div>

        <div class="floating-card card-years">
          <strong>Live now</strong>
          <p>Portfolio refresh in progress</p>
        </div>
      </aside>
    </section>

    <section class="section split-section" id="about">
      <div class="section-copy">
        <p class="section-kicker">About Me</p>
        <h2>Product leader. Trusted adviser. Implementation assurance.</h2>
        <p>
          I partner with HR software organisations to shape strategy, solve complex problems, and
          deliver outcomes that create lasting value for customers and their people.
        </p>
        <div class="chip-row">
          <span>Product Strategy</span>
          <span>Implementation Assurance</span>
          <span>Stakeholder Leadership</span>
          <span>SaaS</span>
          <span>Payroll</span>
          <span>HRIS</span>
        </div>
      </div>

      <div class="experience-list" id="experience">
        <p class="section-kicker">Experience</p>
        {experienceItems.map((item) => (
          <article class="experience-item">
            <div class="experience-marker" aria-hidden="true"></div>
            <div class="experience-content">
              <div class="experience-meta">
                <h3>{item.title}</h3>
                <span>{item.period}</span>
              </div>
              <p>{item.body}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="section work-section" id="work">
      <div class="section-header">
        <div>
          <p class="section-kicker">Examples</p>
          <h2>Featured projects</h2>
        </div>
      </div>

      <div class="work-carousel" tabindex="0" aria-label="Project carousel">
        {workItems.map((item, index) => (
          <article class:list={["work-card", index === 0 ? "work-card-featured" : ""]}>
            <div class="work-preview" style={`--preview-bg: ${item.preview};`}>
              <img class="work-preview-image" src={item.image} alt={item.alt} loading="lazy" />
              <div class="work-preview-overlay" aria-hidden="true"></div>
              <div class="work-number">0{index + 1}</div>
            </div>
            <div class="work-body">
              <span class="work-label">{item.label}</span>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
              <div class="work-links">
                <span class="muted">Screenshot-led case study</span>
                <a href={item.link} target="_blank" rel="noreferrer">{item.linkLabel}</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="section contact-section" id="contact">
      <div class="contact-copy">
        <p class="section-kicker">Contact</p>
        <h2>Let's build better outcomes together.</h2>
        <p>
          Open to advisory, product leadership, and implementation assurance conversations in HR
          software.
        </p>
        <div class="contact-list">
          <a href="mailto:lozknowles@mac.com">lozknowles@mac.com</a>
          <span>Newark, Nottinghamshire, UK</span>
          <a href="https://uk.linkedin.com/in/lozknowles" target="_blank" rel="noreferrer">LinkedIn</a>
        </div>
      </div>

      <div class="contact-panel" aria-label="Contact form preview">
        <div class="form-row">
          <div class="field">
            <label>Name</label>
            <span>Your name</span>
          </div>
          <div class="field">
            <label>Email</label>
            <span>your.email@example.com</span>
          </div>
        </div>
        <div class="field field-message">
          <label>Message</label>
          <span>Tell me about your project or role...</span>
        </div>
        <a class="button primary form-button" href="mailto:lozknowles@mac.com">Send Message</a>
      </div>
    </section>
  </main>
</section>

<style is:global>
  :global(body.bg-black) {
    margin: 0;
    color: #111827;
    background:
      radial-gradient(circle at top left, rgba(134, 161, 255, 0.1), transparent 24%),
      radial-gradient(circle at top right, rgba(210, 193, 255, 0.1), transparent 20%),
      radial-gradient(circle at 85% 82%, rgba(183, 207, 255, 0.1), transparent 18%),
      #ffffff;
    font-family: "Avenir Next", "Segoe UI", "Trebuchet MS", sans-serif;
    line-height: 1.55;
  }

  :global(body.bg-black a) {
    color: inherit;
    text-decoration: none;
  }

  :global(body.bg-black main) {
    display: block;
  }

  .portfolio-shell {
    position: relative;
    width: min(calc(100% - 28px), 1480px);
    margin: 14px auto 36px;
    padding-bottom: 28px;
  }

  .page-glow {
    position: absolute;
    border-radius: 999px;
    filter: blur(10px);
    pointer-events: none;
  }

  .glow-left {
    width: 240px;
    height: 240px;
    left: -60px;
    top: 110px;
    background: rgba(123, 145, 255, 0.12);
  }

  .glow-right {
    width: 280px;
    height: 280px;
    right: -40px;
    bottom: 60px;
    background: rgba(195, 170, 255, 0.14);
  }

  .site-header,
  .page-frame {
    border: 1px solid rgba(120, 132, 164, 0.12);
    background: rgba(255, 255, 255, 0.98);
    box-shadow: 0 20px 60px rgba(126, 143, 194, 0.08);
    backdrop-filter: blur(16px);
  }

  .site-header {
    border-radius: 26px 26px 0 0;
    border-bottom: 0;
  }

  .page-frame {
    border-radius: 0 0 26px 26px;
    overflow: hidden;
  }

  .topbar {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 28px;
    padding: 20px 42px;
  }

  .brand {
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.05em;
    color: #0f172a;
  }

  .topbar-links {
    display: flex;
    justify-content: center;
    gap: 34px;
    color: #475467;
    font-size: 0.98rem;
  }

  .topbar-links a:first-child {
    color: #111827;
    font-weight: 700;
  }

  .topbar-cta {
    justify-self: end;
  }

  .hero-panel {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(420px, 0.95fr);
    gap: 36px;
    align-items: center;
    padding: 44px 42px 28px;
    border-top: 1px solid rgba(120, 132, 164, 0.1);
  }

  .hero-copy {
    padding-right: 12px;
  }

  .intro-line {
    margin: 0 0 10px;
    color: #667085;
    font-size: 1.1rem;
    font-weight: 500;
  }

  h1,
  h2,
  h3 {
    margin: 0;
    letter-spacing: -0.04em;
    color: #0f172a;
  }

  h1 {
    font-size: clamp(3.4rem, 7vw, 5.6rem);
    line-height: 0.96;
    max-width: 8.5ch;
  }

  .hero-subtitle {
    margin: 18px 0 0;
    color: #4f6df5;
    font-size: clamp(1.45rem, 2.5vw, 2rem);
    font-weight: 500;
    letter-spacing: -0.03em;
  }

  .lede {
    max-width: 38rem;
    margin: 18px 0 0;
    color: #667085;
    font-size: 1.18rem;
    line-height: 1.65;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 28px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 0 22px;
    border-radius: 16px;
    font-weight: 700;
    transition: transform 0.18s ease, box-shadow 0.18s ease, background-color 0.18s ease;
  }

  .button:hover {
    transform: translateY(-1px);
  }

  .button.primary {
    color: #111827;
    border: 1px solid rgba(120, 132, 164, 0.14);
    background: linear-gradient(180deg, #fffdfa, #f4f1eb);
    box-shadow: 0 10px 24px rgba(15, 23, 42, 0.08);
  }

  .button.ghost {
    color: #111827;
    border: 1px solid rgba(120, 132, 164, 0.16);
    background: linear-gradient(180deg, #fffdfa, #f4f1eb);
    box-shadow: 0 10px 24px rgba(15, 23, 42, 0.06);
  }

  .signal-strip {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin-top: 22px;
  }

  .signal-card {
    display: grid;
    gap: 8px;
    padding: 16px 18px;
    border-radius: 18px;
    border: 1px solid rgba(120, 132, 164, 0.12);
    background: rgba(255, 255, 255, 0.82);
    box-shadow: 0 14px 28px rgba(126, 143, 194, 0.08);
  }

  .signal-card span {
    color: #5c6cff;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.72rem;
    font-weight: 800;
  }

  .signal-card p {
    margin: 0;
    color: #475467;
    font-size: 0.95rem;
  }

  .hero-visual {
    position: relative;
    min-height: 500px;
    display: flex;
    align-items: end;
    justify-content: center;
  }

  .portrait-halo {
    position: absolute;
    inset: 40px 30px 16px 70px;
    border-radius: 44% 56% 42% 58% / 48% 42% 58% 52%;
    background:
      radial-gradient(circle at top right, rgba(255, 255, 255, 0.72), transparent 24%),
      linear-gradient(135deg, rgba(194, 204, 255, 0.78), rgba(222, 214, 255, 0.78));
  }

  .portrait-image {
    position: relative;
    z-index: 1;
    width: min(100%, 640px);
    max-height: 560px;
    object-fit: contain;
    object-position: center bottom;
    filter: brightness(1.02) contrast(1.02);
  }

  .floating-card {
    position: absolute;
    z-index: 2;
    display: grid;
    gap: 4px;
    min-width: 180px;
    padding: 18px 20px;
    border-radius: 20px;
    border: 1px solid rgba(120, 132, 164, 0.12);
    background: rgba(255, 255, 255, 0.9);
    box-shadow: 0 20px 40px rgba(126, 143, 194, 0.12);
    backdrop-filter: blur(16px);
  }

  .floating-card strong {
    font-size: 1rem;
    color: #0f172a;
  }

  .floating-card p {
    margin: 0;
    color: #667085;
    font-size: 0.92rem;
  }

  .card-availability {
    top: 54px;
    right: 8px;
    grid-template-columns: auto 1fr;
    align-items: start;
    column-gap: 12px;
  }

  .status-dot {
    width: 10px;
    height: 10px;
    margin-top: 6px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 0 5px rgba(34, 197, 94, 0.12);
  }

  .card-trust {
    left: 14px;
    bottom: 94px;
    max-width: 260px;
  }

  .card-years {
    right: -6px;
    bottom: 146px;
    max-width: 180px;
  }

  .section {
    padding: 30px 42px;
    border-top: 1px solid rgba(120, 132, 164, 0.1);
  }

  .split-section {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: 34px;
    align-items: start;
  }

  .section-kicker {
    margin: 0 0 12px;
    color: #5c6cff;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 0.8rem;
    font-weight: 700;
  }

  .section-copy h2,
  .section-header h2,
  .contact-copy h2 {
    font-size: clamp(2rem, 3.2vw, 3.2rem);
    line-height: 1.05;
    max-width: 12ch;
  }

  .section-copy p,
  .contact-copy p {
    max-width: 42rem;
    margin: 18px 0 0;
    color: #667085;
    font-size: 1.04rem;
  }

  .chip-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 22px;
  }

  .chip-row span {
    padding: 8px 12px;
    border-radius: 999px;
    border: 1px solid rgba(120, 132, 164, 0.12);
    background: rgba(255, 255, 255, 0.9);
    color: #344054;
    font-size: 0.88rem;
    font-weight: 600;
  }

  .experience-list {
    padding-left: 28px;
    border-left: 1px solid rgba(120, 132, 164, 0.1);
  }

  .experience-item {
    display: grid;
    grid-template-columns: 26px 1fr;
    gap: 18px;
    align-items: start;
    margin-top: 18px;
  }

  .experience-marker {
    width: 14px;
    height: 14px;
    margin-top: 8px;
    border-radius: 50%;
    background: linear-gradient(135deg, #6b7cff, #8fa0ff);
    box-shadow: 0 0 0 7px rgba(107, 124, 255, 0.12);
  }

  .experience-meta {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    align-items: baseline;
  }

  .experience-meta h3 {
    font-size: 1.18rem;
  }

  .experience-meta span,
  .experience-content p {
    color: #667085;
  }

  .experience-content p {
    margin: 8px 0 0;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 18px;
    margin-bottom: 22px;
  }

  .work-carousel {
    display: grid;
    grid-template-columns: repeat(6, minmax(280px, 1fr));
    gap: 18px;
    overflow-x: auto;
    padding-bottom: 8px;
    scroll-snap-type: x mandatory;
  }

  .work-card {
    scroll-snap-align: start;
    overflow: hidden;
    border-radius: 20px;
    border: 1px solid rgba(120, 132, 164, 0.12);
    background: rgba(255, 255, 255, 0.94);
    box-shadow: 0 14px 30px rgba(126, 143, 194, 0.08);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .work-card-featured {
    box-shadow: 0 18px 42px rgba(126, 143, 194, 0.14);
  }

  .work-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 22px 44px rgba(126, 143, 194, 0.14);
  }

  .work-card:hover .work-preview-image {
    transform: scale(1.03);
  }

  .work-preview {
    position: relative;
    display: grid;
    align-items: end;
    min-height: 220px;
    border-bottom: 1px solid rgba(120, 132, 164, 0.08);
    background: var(--preview-bg);
    overflow: hidden;
  }

  .work-preview-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: saturate(1.02) contrast(1.02);
    transition: transform 0.35s ease;
  }

  .work-preview-overlay {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.04), rgba(255, 255, 255, 0.1)),
      linear-gradient(180deg, transparent 42%, rgba(11, 18, 32, 0.22));
    pointer-events: none;
  }

  .work-preview::before {
    content: "";
    position: absolute;
    inset: 18px;
    border-radius: 18px;
    border: 1px solid rgba(255, 255, 255, 0.16);
  }

  .work-number {
    position: absolute;
    top: 14px;
    left: 14px;
    z-index: 1;
    padding: 8px 10px;
    border-radius: 999px;
    color: #fff;
    background: rgba(10, 18, 25, 0.4);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .work-body {
    display: grid;
    gap: 10px;
    padding: 18px;
  }

  .work-label {
    display: inline-block;
    color: #5c6cff;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .work-body h3 {
    font-size: 1.16rem;
    line-height: 1.2;
  }

  .work-body p {
    margin: 0;
    color: #667085;
    font-size: 0.96rem;
  }

  .work-links {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    align-items: center;
    margin-top: 6px;
    color: #475467;
    font-size: 0.92rem;
  }

  .work-links a {
    white-space: nowrap;
    font-weight: 700;
  }

  .contact-section {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: 32px;
    align-items: start;
  }

  .contact-list {
    display: grid;
    gap: 12px;
    margin-top: 24px;
    color: #475467;
    font-weight: 600;
  }

  .contact-panel {
    padding: 20px;
    border-radius: 22px;
    border: 1px solid rgba(120, 132, 164, 0.12);
    background: rgba(255, 255, 255, 0.92);
    box-shadow: 0 16px 36px rgba(126, 143, 194, 0.08);
  }

  .form-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .field {
    display: grid;
    gap: 8px;
    margin-bottom: 16px;
  }

  .field label {
    color: #344054;
    font-size: 0.88rem;
    font-weight: 700;
  }

  .field span {
    display: flex;
    align-items: center;
