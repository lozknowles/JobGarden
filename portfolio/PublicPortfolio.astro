const nowSignals = [
  {
    label: "Now",
    value: "Turning public work into a more editorial, image-led portfolio.",
  },
  {
    label: "Format",
    value: "Using carousel-style cards, subtle motion, and stronger visual hierarchy.",
  },
  {
    label: "Focus",
    value: "Keeping the site calm, current, and easy to scan on mobile.",
  },
];
---

<section class="portfolio-shell">
  <div class="page-glow glow-left" aria-hidden="true"></div>
  <div class="page-glow glow-right" aria-hidden="true"></div>

  <header class="site-header">
    <nav class="topbar" aria-label="Primary">
      <a class="brand" href="#top">LK.</a>
      <div class="topbar-links">
        <a href="#top">Home</a>
        <a href="#about">About</a>
        <a href="#experience">Experience</a>
        <a href="#professional">Portfolio</a>
        <a href="#tech-ai">Tech &amp; AI</a>
        <a href="#contact">Contact</a>
      </div>
    </nav>
  </header>

  <main class="page-frame" id="top">
    <section class="hero-panel">
      <div class="hero-copy">
        <h1>Lawrence Knowles</h1>
        <p class="hero-subtitle">HR Software Product &amp; Implementation Assurance</p>
        <p class="lede">
          I help HR software teams make better product, delivery, and implementation decisions,
          shaped by SaaS, payroll, enterprise delivery, and customer-facing transformation work.
        </p>

        <div class="hero-actions">
          <a class="button primary" href="#contact">Contact</a>
          <a class="button ghost" href="#tech-ai">Portfolio</a>
        </div>
      </div>

      <aside class="profile-panel" aria-label="Profile and quick facts">
        <div class="hero-feature">
          <span class="panel-label">Public portfolio</span>
          <strong>Product leadership, implementation assurance, and technical experiments in one view.</strong>
          <p>
            A self-contained visual panel that keeps the site resilient while still feeling
            image-led and current.
          </p>
          <div class="hero-feature-grid" aria-label="Portfolio highlights">
            <div>
              <span>Focus</span>
              <strong>HR software</strong>
            </div>
            <div>
              <span>Style</span>
              <strong>Editorial / calm</strong>
            </div>
            <div>
              <span>Output</span>
              <strong>Selected work</strong>
            </div>
            <div>
              <span>Context</span>
              <strong>UK portfolio</strong>
            </div>
          </div>
        </div>
        <div class="panel-card accent">
          <span class="panel-label">Current focus</span>
          <strong>Helping HR software teams make better product, delivery, and implementation decisions.</strong>
        </div>
        <div class="panel-card">
          <span class="panel-label">Working style</span>
          <p>Commercial, strategic, relationship-led, and comfortable working with senior stakeholders and leadership teams.</p>
        </div>
        <div class="panel-card">
          <span class="panel-label">Live now</span>
          <p>
            Portfolio refresh in progress, with more visual project stories and stronger current work.
          </p>
        </div>
      </aside>
    </section>

    <section class="section split-section" id="about">
      <div class="section-copy">
        <h2>Product leader. Trusted adviser. Implementation assurance.</h2>
        <p>
          I partner with HR software organisations to shape strategy, solve complex problems, and
          deliver outcomes that create lasting value for customers and their people.
        </p>
        <div class="chip-row">
          <span>Product Strategy</span>
          <span>Implementation Assurance</span>
          <span>Stakeholder Leadership</span>
          <span>SaaS</span>
          <span>Payroll</span>
          <span>HRIS</span>
        </div>
      </div>

      <div class="experience-list" id="experience">
        {experienceItems.map((item) => (
          <article class="experience-item">
            <div class="experience-marker" aria-hidden="true"></div>
            <div class="experience-content">
              <div class="experience-meta">
                <h3>{item.title}</h3>
                <span>{item.period}</span>
              </div>
              <p>{item.body}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="section" id="professional">
      <div class="section-header">
        <h2>Core disciplines and experience</h2>
      </div>

      <div class="card-grid two-up">
        {professionalItems.map((item) => (
          <article class="work-card work-card-professional">
            <div class="work-body">
              <span class="work-label">{item.label}</span>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="section work-section" id="tech-ai">
      <div class="section-header">
        <div>
          <p class="section-kicker">Selected work</p>
          <h2>Example projects and experiments</h2>
          <p class="section-note">
            Scroll sideways to browse the cards. The carousel is intentionally tactile, not auto-playing.
          </p>
        </div>
      </div>

      <div class="work-carousel" tabindex="0" aria-label="Project carousel">
        {workItems.map((item, index) => (
          <article class:list={["work-card", index === 0 ? "work-card-featured" : ""]}>
            <div class="work-preview" style={`--preview-bg: ${item.preview};`}>
              <img class="work-preview-image" src={item.image} alt={item.alt} loading="lazy" />
              <div class="work-preview-overlay" aria-hidden="true"></div>
              <div class="work-number">0{index + 1}</div>
            </div>
            <div class="work-body">
              <span class="work-label">{item.label}</span>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
              <div class="work-links">
                <span class="muted">Screenshot-led case study</span>
                <a href={item.link} target="_blank" rel="noreferrer">{item.linkLabel}</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="section contact-section" id="contact">
      <div class="contact-copy">
        <h2>Let's build better outcomes together.</h2>
        <p>
          Open to advisory, product leadership, and implementation assurance conversations in HR
          software.
        </p>
        <div class="contact-list">
          <a href="mailto:lozknowles@mac.com">lozknowles@mac.com</a>
          <span>Newark, Nottinghamshire, UK</span>
          <a href="https://uk.linkedin.com/in/lozknowles" target="_blank" rel="noreferrer">LinkedIn</a>
        </div>
      </div>

      <div class="contact-panel" aria-label="Contact form preview">
        <div class="form-row">
          <div class="field">
            <label>Name</label>
            <span>Your name</span>
          </div>
          <div class="field">
            <label>Email</label>
            <span>your.email@example.com</span>
          </div>
        </div>
        <div class="field field-message">
          <label>Message</label>
          <span>Tell me about your project or role...</span>
        </div>
        <a class="button primary form-button" href="mailto:lozknowles@mac.com">Send Message</a>
      </div>
    </section>
  </main>
</section>

<style is:global>
  :global(body.bg-black) {
    margin: 0;
    color: #111827;
    background:
      radial-gradient(circle at top left, rgba(134, 161, 255, 0.1), transparent 24%),
      radial-gradient(circle at top right, rgba(210, 193, 255, 0.1), transparent 20%),
      radial-gradient(circle at 85% 82%, rgba(183, 207, 255, 0.1), transparent 18%),
      #ffffff;
    font-family: "Avenir Next", "Segoe UI", "Trebuchet MS", sans-serif;
    line-height: 1.55;
  }

  :global(body.bg-black a) {
    color: inherit;
    text-decoration: none;
  }

  :global(body.bg-black main) {
    display: block;
  }

  .portfolio-shell {
    position: relative;
    width: min(calc(100% - 28px), 1480px);
    margin: 14px auto 36px;
    padding-bottom: 28px;
  }

  .page-glow {
    position: absolute;
    border-radius: 999px;
    filter: blur(10px);
    pointer-events: none;
  }

  .glow-left {
    width: 240px;
    height: 240px;
    left: -60px;
    top: 110px;
    background: rgba(123, 145, 255, 0.12);
  }

  .glow-right {
    width: 280px;
    height: 280px;
    right: -40px;
    bottom: 60px;
    background: rgba(195, 170, 255, 0.14);
  }

  .site-header,
  .page-frame {
    border: 1px solid rgba(120, 132, 164, 0.12);
    background: rgba(255, 255, 255, 0.98);
    box-shadow: 0 20px 60px rgba(126, 143, 194, 0.08);
    backdrop-filter: blur(16px);
  }

  .site-header {
    border-radius: 26px 26px 0 0;
    border-bottom: 0;
  }

  .page-frame {
    border-radius: 0 0 26px 26px;
    overflow: hidden;
  }

  .topbar {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 28px;
    padding: 20px 42px;
  }

  .brand {
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.05em;
    color: #0f172a;
  }

  .topbar-links {
    display: flex;
    justify-content: center;
    gap: 34px;
    color: #475467;
    font-size: 0.98rem;
  }

  .topbar-links a:first-child {
    color: #111827;
    font-weight: 700;
  }

  .topbar-cta {
    justify-self: end;
  }

  .hero-panel {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(420px, 0.95fr);
    gap: 36px;
    align-items: center;
    padding: 44px 42px 28px;
    border-top: 1px solid rgba(120, 132, 164, 0.1);
  }

  .hero-copy {
    padding-right: 12px;
  }

  .intro-line {
    margin: 0 0 10px;
    color: #667085;
    font-size: 1.1rem;
    font-weight: 500;
  }

  h1,
  h2,
  h3 {
    margin: 0;
    letter-spacing: -0.04em;
    color: #0f172a;
  }

  h1 {
    font-size: clamp(3.4rem, 7vw, 5.6rem);
    line-height: 0.96;
    max-width: 8.5ch;
  }

  .hero-subtitle {
    margin: 18px 0 0;
    color: #4f6df5;
    font-size: clamp(1.45rem, 2.5vw, 2rem);
    font-weight: 500;
    letter-spacing: -0.03em;
  }

  .lede {
    max-width: 38rem;
    margin: 18px 0 0;
    color: #667085;
    font-size: 1.18rem;
    line-height: 1.65;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 28px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 0 22px;
    border-radius: 16px;
    font-weight: 700;
    transition: transform 0.18s ease, box-shadow 0.18s ease, background-color 0.18s ease;
  }

  .button:hover {
    transform: translateY(-1px);
  }

  .button.primary {
    color: #111827;
    border: 1px solid rgba(120, 132, 164, 0.14);
    background: linear-gradient(180deg, #fffdfa, #f4f1eb);
    box-shadow: 0 10px 24px rgba(15, 23, 42, 0.08);
  }

  .button.ghost {
    color: #111827;
    border: 1px solid rgba(120, 132, 164, 0.16);
    background: linear-gradient(180deg, #fffdfa, #f4f1eb);
    box-shadow: 0 10px 24px rgba(15, 23, 42, 0.06);
  }

  .profile-panel {
    display: grid;
    gap: 14px;
    padding: 18px;
    border-radius: 24px;
  }

  .hero-feature {
    display: grid;
    gap: 14px;
    padding: 24px;
    min-height: 520px;
    border-radius: 22px;
    border: 1px solid rgba(22, 33, 44, 0.08);
    background:
      linear-gradient(180deg, rgba(15, 25, 34, 0.05), rgba(15, 25, 34, 0.16)),
      linear-gradient(145deg, rgba(255, 255, 255, 0.54), rgba(255, 255, 255, 0.18));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.46);
  }

  .hero-feature strong {
    font-family: "Iowan Old Style", "Palatino Linotype", "Book Antiqua", Georgia, serif;
    font-size: clamp(1.55rem, 2.6vw, 2.1rem);
    line-height: 1.05;
    letter-spacing: -0.04em;
    color: #0f172a;
  }

  .hero-feature p {
    margin: 0;
    max-width: 34ch;
    color: #52606d;
    font-size: 1rem;
  }

  .hero-feature-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin-top: auto;
  }

  .hero-feature-grid div {
    display: grid;
    gap: 4px;
    padding: 14px 16px;
    border-radius: 16px;
    border: 1px solid rgba(22, 33, 44, 0.08);
    background: rgba(255, 255, 255, 0.76);
  }

  .hero-feature-grid span {
    color: #5c6cff;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.7rem;
    font-weight: 800;
  }

  .hero-feature-grid strong {
    font-family: inherit;
    font-size: 0.98rem;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .panel-card {
    border-radius: 18px;
    padding: 18px;
    background: rgba(255, 255, 255, 0.58);
    border: 1px solid rgba(22, 33, 44, 0.08);
  }

  .panel-card.accent {
    background: linear-gradient(160deg, rgba(33, 94, 99, 0.12), rgba(255, 255, 255, 0.84));
  }

  .panel-label {
    display: block;
    margin-bottom: 8px;
    font-size: 0.74rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #667085;
  }

  .panel-card p {
    margin: 0;
    color: #667085;
  }

  .signal-strip {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin-top: 22px;
  }

  .signal-card {
    display: grid;
    gap: 8px;
    padding: 16px 18px;
    border-radius: 18px;
    border: 1px solid rgba(120, 132, 164, 0.12);
    background: rgba(255, 255, 255, 0.82);
    box-shadow: 0 14px 28px rgba(126, 143, 194, 0.08);
  }

  .signal-card span {
    color: #5c6cff;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.72rem;
    font-weight: 800;
  }

  .signal-card p {
    margin: 0;
    color: #475467;
    font-size: 0.95rem;
  }

  .section {
    padding: 30px 42px;
    border-top: 1px solid rgba(120, 132, 164, 0.1);
  }

  .split-section {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: 34px;
    align-items: start;
  }

  .section-kicker {
    margin: 0 0 12px;
    color: #5c6cff;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 0.8rem;
    font-weight: 700;
  }

  .section-copy h2,
  .section-header h2,
  .contact-copy h2 {
    font-size: clamp(2rem, 3.2vw, 3.2rem);
    line-height: 1.05;
    max-width: 12ch;
  }

  .section-copy p,
  .contact-copy p {
    max-width: 42rem;
    margin: 18px 0 0;
    color: #667085;
    font-size: 1.04rem;
  }

  .section-note {
    max-width: 42ch;
    margin: 4px 0 0;
    color: #667085;
    font-size: 0.96rem;
  }

  .chip-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 22px;
  }

  .chip-row span {
    padding: 8px 12px;
    border-radius: 999px;
    border: 1px solid rgba(120, 132, 164, 0.12);
    background: rgba(255, 255, 255, 0.9);
    color: #344054;
    font-size: 0.88rem;
    font-weight: 600;
  }

  .experience-list {
    padding-left: 28px;
    border-left: 1px solid rgba(120, 132, 164, 0.1);
  }

  .experience-item {
    display: grid;
    grid-template-columns: 26px 1fr;
    gap: 18px;
    align-items: start;
    margin-top: 18px;
  }

  .experience-marker {
    width: 14px;
    height: 14px;
    margin-top: 8px;
    border-radius: 50%;
    background: linear-gradient(135deg, #6b7cff, #8fa0ff);
    box-shadow: 0 0 0 7px rgba(107, 124, 255, 0.12);
  }

  .experience-meta {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    align-items: baseline;
  }

  .experience-meta h3 {
    font-size: 1.18rem;
  }

  .experience-meta span,
  .experience-content p {
    color: #667085;
  }

  .experience-content p {
    margin: 8px 0 0;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 18px;
    margin-bottom: 22px;
  }

  .card-grid {
    display: grid;
    gap: 18px;
  }

  .card-grid.two-up {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .work-carousel {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(280px, 34vw);
    gap: 18px;
    overflow-x: auto;
    padding: 2px 2px 8px;
    scroll-padding-inline: 2px;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .work-carousel::-webkit-scrollbar {
    display: none;
  }

  .work-card {
    scroll-snap-align: start;
    overflow: hidden;
    border-radius: 20px;
    border: 1px solid rgba(120, 132, 164, 0.12);
    background: rgba(255, 255, 255, 0.94);
    box-shadow: 0 14px 30px rgba(126, 143, 194, 0.08);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .work-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .work-card-professional {
    display: flex;
    flex-direction: column;
  }

  .work-card-professional {
    display: flex;
    flex-direction: column;
  }

  .work-card-featured {
    box-shadow: 0 18px 42px rgba(126, 143, 194, 0.14);
  }

  .work-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 22px 44px rgba(126, 143, 194, 0.14);
  }

  .work-card:hover .work-preview-image {
    transform: scale(1.03);
  }

