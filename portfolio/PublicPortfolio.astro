    link: "https://www.youtube.com/@LawrenceKnowles-cr9ml",
    linkLabel: "Open on YouTube",
    preview: "linear-gradient(135deg, rgba(14, 94, 121, 0.34), rgba(11, 18, 32, 0.9))",
  },
  {
